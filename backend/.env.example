# Copie ce fichier en .env et adapte les valeurs
PORT=3000
# Génère une clé longue et aléatoire, ex : openssl rand -hex 32
JWT_SECRET=change-me

# Optionnel : synchronisation de la liste des collègues autorisés depuis Grist
# 1. Dans Grist : crée un document avec un tableau "Autorisations" (colonne Email,
#    optionnellement Nom et Actif)
# 2. Crée une clé API dans Grist (Paramètres du compte > Clés API)
# 3. Renseigne ci-dessous, puis lance la synchro depuis l'app (écran Admin)
GRIST_ENDPOINT=https://api.getgrist.com
GRIST_API_KEY=
GRIST_DOC_ID=
GRIST_TABLE=Autorisations
